rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /level_requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'request', 'createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 100 && request.resource.data.name.size() > 0
                    && request.resource.data.email is string && request.resource.data.email.size() <= 150 && request.resource.data.email.size() > 0
                    && request.resource.data.request is string && request.resource.data.request.size() <= 1000 && request.resource.data.request.size() > 0
                    && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }
  }
}
